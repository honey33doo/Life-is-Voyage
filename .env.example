# ============================================================
# .env.example — 환경변수 선언 (실제 값 없음)
# ============================================================
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
# .env 파일은 절대 git 에 커밋하지 마세요.

# ── Anthropic API ────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── GitHub ───────────────────────────────────────────────────
GITHUB_REPO_URL=

# ── YouTube OAuth ────────────────────────────────────────────
# config/youtube_client_secret.json 경로로 대체 가능
YOUTUBE_CLIENT_SECRET_PATH=

# ── Instagram Graph API ──────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── 네이버 Blog API ──────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 티스토리 Open API ────────────────────────────────────────
TISTORY_ACCESS_TOKEN=
TISTORY_BLOG_NAME=
